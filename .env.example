# Copy these values into your hosting provider's environment settings.
NODE_ENV=production
PORT=3000
DATA_DIR=/var/data
# Generate a unique random secret (at least 32 characters) before deployment.
SESSION_SECRET=replace-with-a-long-random-secret

# Contact form delivery through Resend's HTTPS API (works on Render Free).
# Create a free API key at https://resend.com/api-keys and add it as a secret in Render.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
# The default sender is Resend's onboarding sender. For production/customer recipients,
# verify a sending domain with Resend and set EMAIL_FROM to an address on that domain.
EMAIL_FROM="Studious <onboarding@resend.dev>"
CONTACT_TO="your-email@gmail.com"

