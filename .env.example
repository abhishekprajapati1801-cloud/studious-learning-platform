# Copy these values into your hosting provider's environment settings.
NODE_ENV=production
PORT=3000
DATA_DIR=/var/data
# Generate a unique random secret (at least 32 characters) before deployment.
SESSION_SECRET=replace-with-a-long-random-secret

# EMAIL_USER: Your Gmail address for sending contact form emails.
# EMAIL_PASS: Your Gmail App Password (NOT your regular password).
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
CONTACT_TO="your-email@gmail.com"
